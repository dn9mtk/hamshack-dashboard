# Station identity (optional – otherwise set in Settings UI)
# Used by AI assistant, repeater distance, PSK Reporter, propagation, map, etc.
# CALLSIGN=YOURCALL
# LOCATOR=JO40FD
# QTH_NAME=Taunus Mountains * Germany

# DX Cluster Configuration
# Example: DXCLUSTER_HOST=dxcluster.example.com
# Example: DXCLUSTER_PORT=7300
# Example: DXCLUSTER_CALLSIGN=YOURCALL

DXCLUSTER_HOST=
DXCLUSTER_PORT=
DXCLUSTER_CALLSIGN=

# RBN (Reverse Beacon Network) Configuration
# Example: RBN_HOST=rbn.example.com
# Example: RBN_PORT=7000
# Example: RBN_CALLSIGN=YOURCALL

RBN_HOST=
RBN_PORT=
RBN_CALLSIGN=

# News banner RSS URL (optional, default: ARRL news)
# NEWS_RSS_URL=https://www.arrl.org/news/rss
# DARC news (German): NEWS_RSS_URL=https://www.darc.de/rss.xml

# DXpeditions list (optional). If unset, NG3K ADXO is fetched automatically.
# For NG3K ADXO (OpenHamClock-style, HTML parsed automatically):
# DXPEDITION_URL=https://www.ng3k.com/Misc/adxoplain.html
# Or use a JSON URL returning [{ callsign, entity, startDate, endDate, status?, url? }]
# DXPEDITION_URL=

# Server Port (optional, defaults to 8788)
# PORT=8788

# Popular DX Cluster servers:
# - dxcluster.net:7300
# - dxc.ve7cc.net:7300
# - dxc.sp7dxc.pl:7300
# - dxc.dxcluster.org:7300

# Popular RBN servers:
# - reversebeacon.net:7000
# - rbn.telegraphy.de:7000

# APRS (optional – for APRS layer on map: tracked stations from aprs.fi)
# Get key at https://aprs.fi/account/ (sign up, free)
# APRS_FI_API_KEY=

# Map tiles (optional – base map; without these, OpenStreetMap tiles are used)
# Tiles are fetched by the server (/api/tiles), so keys never reach the browser.
# CARTO Positron (light): get a key at https://carto.com/basemaps/apikey
# An invalid or expired CARTO key is not detected: tiles then show an "API KEY REQUIRED" watermark.
# CARTO_API_KEY=
# Any other provider: URL template with {z}, {x}, {y} (takes precedence over CARTO_API_KEY)
# Example: MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png?key=YOUR_KEY
# MAP_TILE_URL=
# Attribution HTML for MAP_TILE_URL (default: OpenStreetMap contributors)
# MAP_TILE_ATTRIBUTION=

# OpenSky (optional – for Aircraft layer: higher rate limits with OAuth2)
# Create API client at https://opensky-network.org/ -> Account -> API Clients
# OPENSKY_CLIENT_ID=your-email-api-client
# OPENSKY_CLIENT_SECRET=your_client_secret

# AviationStack (optional – for flight route Origin/Destination in Aircraft popup)
# Free plan: 100 requests/month. Get key at https://aviationstack.com/
# AVIATIONSTACK_API_KEY=

# Blitzortung (optional – for Lightning layer: live data instead of archive)
# Get credentials at https://www.blitzortung.org/
# BLITZORTUNG_USER=your_login
# BLITZORTUNG_PASS=your_password

# AI Assistant (Ollama, local – free)
# Install from https://ollama.com, then: ollama serve & ollama pull llama3.2
# Same machine: OLLAMA_URL=http://localhost:11434/v1
# Remote Ollama:  OLLAMA_URL=http://192.168.1.x:11434/v1
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# Rig control: Yaesu FT-991A through hamlib rigctld (optional, off by default)
# See server/SETUP.md "Rig control (Yaesu FT-991A)". rigctld must listen on loopback only.
# RIGCTLD_ENABLED=false
# RIGCTLD_HOST=127.0.0.1
# RIGCTLD_PORT=4532
# RIG_POLL_MS=1000
# RIGCTLD_TIMEOUT_MS=5000
# German licence class N, E or A: the dashboard only tunes to the bands of this class
# RIG_LICENCE_CLASS=N
# LaunchAgent generator (npm run rig:launchagent): RIGCTLD_DEVICE is required (no default),
# CAT port = Enhanced port of the CP2105 (ends in 0)
# RIGCTLD_DEVICE=/dev/cu.usbserial-XXXXXXXX0
# RIGCTLD_BIN=/opt/homebrew/bin/rigctld
# RIGCTLD_MODEL=1035
# RIGCTLD_BAUD=9600
# RIGCTLD_LAUNCHAGENT_LABEL=de.dn9mtk.rigctld
